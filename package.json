{
  "name": "claudetop",
  "productName": "claudetop",
  "version": "0.8.2",
  "description": "A little Claude that lives at the bottom of your screen and shows what Claude Code is up to",
  "author": "potata",
  "repository": "github:benceandrastoth-ply/claudetop",
  "license": "MIT",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb",
    "release": "node scripts/publish-release.js",
    "install-hooks": "node scripts/install-hooks.js",
    "uninstall-hooks": "node scripts/install-hooks.js --uninstall"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "app.claudetop",
    "productName": "claudetop",
    "files": [
      "src/**",
      "hooks/**",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/claude.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "claudetop",
      "installerIcon": "assets/claude.ico",
      "uninstallerIcon": "assets/claude.ico",
      "uninstallDisplayName": "claudetop",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Utility",
      "synopsis": "A tiny Claude for your taskbar",
      "maintainer": "potata <benceandrastoth-ply@users.noreply.github.com>",
      "executableArgs": ["--no-sandbox"],
      "artifactName": "claudetop-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0",
        "libuuid1", "libsecret-1-0", "libgbm1", "libasound2t64 | libasound2"
      ],
      "recommends": ["libappindicator3-1", "x11-utils", "xdotool", "playerctl"]
    }
  }
}
